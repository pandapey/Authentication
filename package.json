{
  "name": "auth-mern",
  "version": "1.0.0",
  "main": "server/server.js",
  "type": "module",
  "scripts": {
    "server": "cross-env NODE_ENV=development nodemon --watch server --ext js,json server/server.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "start": "cross-env NODE_ENV=production node server/server.js",
    "build": "npm install && npm install --prefix client && npm run build --prefix client",
    "test": "cross-env NODE_ENV=test node --test tests/auth.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.1",
    "nodemailer": "^9.1.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.3.0"
  }
}
